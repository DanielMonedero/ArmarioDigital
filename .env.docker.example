# ============================================================
# Wardrobe - plantilla de entorno DOCKER
# ============================================================
# Copia este fichero a .env.docker y ajusta los valores.
# docker-compose.yml carga .env.docker (que está en .gitignore).
#
# Plantilla:  cp .env.docker.example .env.docker
# ============================================================

# --- Database (Postgres en la red de docker compose) ---
DB_URL=jdbc:postgresql://postgres:5432/wardrobe
DB_USERNAME=wardrobe
DB_PASSWORD=changeme

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Session ---
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=24h

# --- CORS (origen desde el que se sirve el frontend) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage (ruta dentro del contenedor; el volumen lo monta en /app/data/images) ---
APP_STORAGE_IMAGES_PATH=/app/data/images

# --- Upload limits ---
APP_UPLOAD_MAX_SIZE=10MB
APP_UPLOAD_MAX_REQUEST_SIZE=11MB

# --- Auth ---
# Ponlo a true para permitir crear usuarios vía POST /api/auth/users
APP_AUTH_ALLOW_USER_CREATION=false

# --- Seed (crea el usuario admin al arrancar; desactívalo en prod real) ---
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_DISPLAY_NAME=Admin
