# ============================================================
# Wardrobe - plantilla de entorno DOCKER
# ============================================================
# Copia este fichero a .env.docker y ajusta los valores.
#   cp .env.docker.example .env.docker
#
# docker-compose.yml carga .env.docker (que está en .gitignore)
# y, además, usa estas variables con sustitución ${VAR}, así que
# las que afectan a Postgres SON LAS MISMAS que ve el backend.
#
# ============================================================
#  IMPORTANTE sobre DB_PASSWORD
# ============================================================
# El valor de DB_PASSWORD que haya aquí la primera vez que arranque
# Postgres QUEDA GRABADO en el volumen wardrobe-db. Cambiarlo después
# requiere borrar el volumen (docker compose down -v) y se pierden
# los datos. Usa una contraseña razonable desde el principio.
# ============================================================

# --- Database (Postgres + backend, ambos usan estas) ---
DB_NAME=wardrobe
DB_USERNAME=wardrobe
DB_PASSWORD=cambia-esto-por-una-contraseña-fuerte
DB_URL=jdbc:postgresql://postgres:5432/wardrobe

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Session ---
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=24h

# --- CORS (sin efecto en despliegue same-origin; conserva si quieres
#     exponer la API a otro origen más adelante) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Storage (ruta dentro del contenedor; el volumen la monta en /app/data/images) ---
APP_STORAGE_IMAGES_PATH=/app/data/images

# --- Upload limits ---
APP_UPLOAD_MAX_SIZE=10MB
APP_UPLOAD_MAX_REQUEST_SIZE=11MB

# --- Auth ---
# Ponlo a true para permitir crear usuarios vía POST /api/auth/users
APP_AUTH_ALLOW_USER_CREATION=true

# --- Seed (crea el usuario admin al arrancar) ---
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambia-esto
SEED_ADMIN_DISPLAY_NAME=Admin
