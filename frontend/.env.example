# Base URL used by the frontend when calling the backend directly.
# Leave empty to use the Vite dev-server proxy (recommended in dev) or to
# rely on same-origin in production.
VITE_API_BASE_URL=

# Override the backend target used by the Vite dev proxy (defaults to
# http://localhost:8080, the Spring Boot server).
VITE_API_PROXY_TARGET=http://localhost:8080
